:root{--sky:#dff1fb;--grass:#8fcf8a;--grass2:#6dbb68;--pink:#ffc4d1;--sun:#ffe08a;--ink:#3b3a56;--white:#fff}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:"Nunito","Segoe UI",Arial,sans-serif;background:var(--sky);color:var(--ink);line-height:1.65}
a{color:inherit}
nav{display:flex;justify-content:center;align-items:center;gap:10px;flex-wrap:wrap;padding:16px}
nav a{background:var(--white);padding:8px 18px;border-radius:999px;font-weight:800;text-decoration:none;box-shadow:0 4px 0 #b6d6e8}
nav a:hover{background:var(--sun)}
