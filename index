nav .lg img{width:34px;height:34px}
.wrap{max-width:1040px;margin:auto;padding:0 20px}
.hero{max-width:1040px;margin:10px auto;padding:20px;display:grid;grid-template-columns:1fr 1fr;gap:34px;align-items:center}
.hero img.main{width:100%;border-radius:40% 60% 55% 45%/50% 45% 55% 50%;border:8px solid #fff;box-shadow:0 14px 30px rgba(59,58,86,.22);aspect-ratio:3/4;object-fit:cover}
.hero h1{font-size:clamp(2rem,5vw,3.2rem);line-height:1.15;margin-bottom:14px}
.hero h1 em{font-style:normal;background:linear-gradient(transparent 60%,var(--pink) 60%)}
.hero p{margin-bottom:20px;font-size:1.1rem}
.btn{display:inline-block;background:var(--ink);color:#fff;padding:14px 30px;border-radius:18px;font-weight:900;text-decoration:none;box-shadow:0 6px 0 #1d1c33;margin:0 8px 10px 0}
.btn:hover{transform:translateY(3px);box-shadow:0 3px 0 #1d1c33}
.btn.pk{background:#ff8fab;box-shadow:0 6px 0 #d9607d}
.meadow{background:var(--grass);border-radius:60px 60px 0 0;padding:56px 20px 70px;margin-top:40px}
.inner{max-width:1040px;margin:auto}
h2{text-align:center;color:#fff;font-size:2.1rem;margin:0 0 8px;text-shadow:0 2px 0 rgba(0,0,0,.15)}
.sub{text-align:center;color:#fff;max-width:640px;margin:0 auto 28px;font-weight:700}
.blk{margin-bottom:64px}
.steps{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:20px}
.step{background:#fff;border-radius:28px;padding:22px;text-align:center;text-decoration:none;transition:.2s;box-shadow:0 8px 0 rgba(0,0,0,.08);display:block}
a.step:hover{transform:translateY(-6px) rotate(-1deg)}
.step .n{width:46px;height:46px;border-radius:50%;background:var(--sun);display:grid;place-items:center;font-weight:900;font-size:1.3rem;margin:0 auto 10px}
.step h3{margin-bottom:6px}
.demo{display:grid;grid-template-columns:auto 1fr;gap:34px;align-items:center;background:#fff;border-radius:34px;padding:30px;box-shadow:0 8px 0 rgba(0,0,0,.08)}
.board{display:grid;grid-template-columns:repeat(4,64px);grid-template-rows:repeat(4,64px);border:4px solid var(--ink);border-radius:10px;overflow:hidden}
.board div{display:grid;place-items:center;font-size:1.8rem;font-weight:900;border:1px solid #c9c9dc;background:#fbfbff}
.board .g{background:#eef0ff}
.board .q{background:var(--sun);color:#d2692e}
.board div:nth-child(4n+2),.board div:nth-child(4n+3){}
.board div:nth-child(2),.board div:nth-child(6),.board div:nth-child(10),.board div:nth-child(14){border-right:3px solid var(--ink)}
.board div:nth-child(n+9):nth-child(-n+12){border-top:3px solid var(--ink)}
.demo h3{font-size:1.5rem;margin-bottom:8px}
.demo p{margin-bottom:10px}
.sizes{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:18px}
.size{background:#fff;border-radius:26px;padding:22px;box-shadow:0 8px 0 rgba(0,0,0,.08)}
.size b{display:inline-block;background:var(--pink);border-radius:12px;padding:2px 12px;margin-bottom:8px}
.pics{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:18px}
.pics img{width:100%;height:360px;object-fit:cover;border-radius:28px;border:6px solid #fff}
.pics.two img{height:320px}
.class{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:18px}
.class div{background:#fff;border-radius:24px;padding:22px;box-shadow:0 8px 0 rgba(0,0,0,.08)}
.class div b{display:block;margin-bottom:4px;color:#d2692e}
details{background:#fff;border-radius:18px;padding:16px 22px;margin-bottom:12px;box-shadow:0 5px 0 rgba(0,0,0,.08)}
summary{cursor:pointer;font-weight:900}
details p{margin-top:8px}
.social{text-align:center}
