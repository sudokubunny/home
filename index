.social a:hover{background:#fff}
footer{background:var(--grass2);color:#fff;text-align:center;padding:24px;font-weight:700}
footer a{margin:0 8px}
@media(max-width:780px){.hero{grid-template-columns:1fr}.demo{grid-template-columns:1fr;justify-items:center}}
